rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Fotos de la quinta: lectura pública, escritura solo autenticado
    match /quinta/fotos/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Todo lo demás requiere auth
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
