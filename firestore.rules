rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Público: micrositio de la quinta puede leer sin autenticación
    match /quinta_config/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /reservas/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /precios_quinta/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Pre-reservas: cualquiera puede crear, solo auth puede leer/modificar
    match /pre_reservas/{doc} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
    // Todo lo demás requiere auth
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
